<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set titrePage = (title + " · " + site.nom + " de " + site.ville) if title else (site.nom + " · " + site.ville) %}
  <title>{{ titrePage }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:title" content="{{ titrePage }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta name="theme-color" content="#123D32">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/cormorant-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-sans-3.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>document.documentElement.classList.add("js")</script>
  {% include "partials/schema.njk" %}
</head>
<body class="page-{{ pageClass or 'interne' }}">
  <a class="lien-evitement" href="#contenu">Aller au contenu</a>
  {% include "partials/header.njk" %}
  <main id="contenu" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
